  <timelineMarker markerStart="8" markerLength="0" colour="#FFFF00FF" note="Hello, I&apos;m verity!" name="Verity"/>
  <timelineMarker markerStart="9" markerLength="0" colour="#FFFF00FF" note="Your personal helper friend." name="Verity"/>
  <timelineMarker markerStart="10" markerLength="0" colour="#FFFF00FF" note="Ask me anything! I know everything." name="Verity"/>
  <timelineMarker markerStart="11" markerLength="0" colour="#2288FFFF" note="verity, huh?" name="Sans"/>
  <timelineMarker markerStart="12" markerLength="0" colour="#2288FFFF" note="hmm... you kinda look like someone i know." name="Sans"/>
  <timelineMarker markerStart="13" markerLength="0" colour="#2288FFFF" note="you aren&apos;t gonna act friendly and then try to kill me right?" name="Sans"/>
