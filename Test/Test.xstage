  <timelineMarker markerStart="19" markerLength="0" colour="#FFFF00FF" note="21!" name="Verity"/>
  <timelineMarker markerStart="20" markerLength="0" colour="#2288FFFF" note="is water wet?" name="Sans"/>
  <timelineMarker markerStart="21" markerLength="0" colour="#FFFF00FF" note="Not in the traditional sense, however it makes other things wet!" name="Verity"/>
  <timelineMarker markerStart="22" markerLength="0" colour="#2288FFFF" note="what was the common name of gold during the 2013 era of minecraft?" name="Sans"/>
  <timelineMarker markerStart="23" markerLength="0" colour="#FFFF00FF" note="It was butter, of course!" name="Verity"/>
  <timelineMarker markerStart="24" markerLength="0" colour="#2288FFFF" note="huh." name="Sans"/>
  <timelineMarker markerStart="25" markerLength="0" colour="#2288FFFF" note="that&apos;s some elite “ball” knowledge." name="Sans"/>
  <timelineMarker markerStart="26" markerLength="0" colour="#2288FFFF" note="welp, i better get started on this playthrough." name="Sans"/>
  <timelineMarker markerStart="27" markerLength="0" colour="#2288FFFF" note="i&apos;m probably gonna gather some materials, build a house, and maybe explore a village?" name="Sans"/>
  <timelineMarker markerStart="28" markerLength="0" colour="#FFFF00FF" note="The nearest village is 842 blocks northeast of your current location." name="Verity"/>
