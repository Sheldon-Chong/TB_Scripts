  <timelineMarker markerStart="46" markerLength="0" colour="#2288FFFF" note="i have no clue actually, someone sent me it on discord" name="Sans"/>
  <timelineMarker markerStart="47" markerLength="0" colour="#2288FFFF" note="woah!" name="Sans"/>
  <timelineMarker markerStart="48" markerLength="0" colour="#FFFF00FF" note="Hello, I&apos;m verity!" name="Verity"/>
  <timelineMarker markerStart="49" markerLength="0" colour="#2288FFFF" note="fwe" name="Sans"/>
  <timelineMarker markerStart="50" markerLength="0" colour="#FFFF00FF" note="Your personal helper friend." name="Verity"/>
  <timelineMarker markerStart="51" markerLength="0" colour="#FFFFFFFF" note="s" name="s"/>
  <timelineMarker markerStart="52" markerLength="0" colour="#FFFF00FF" note="Ask me anything! I know everything." name="Verity"/>
  <timelineMarker markerStart="53" markerLength="0" colour="#2288FFFF" note="verity, huh?" name="Sans"/>
  <timelineMarker markerStart="54" markerLength="0" colour="#2288FFFF" note="hmm... you kinda look like someone i know." name="Sans"/>
  <timelineMarker markerStart="55" markerLength="0" colour="#2288FFFF" note="you aren&apos;t gonna act friendly and then try to kill me right?" name="Sans"/>
  <timelineMarker markerStart="56" markerLength="0" colour="#FFFF00FF" note="Whaaat?? No...?" name="Verity"/>
  <timelineMarker markerStart="57" markerLength="0" colour="#FFFF00FF" note="I&apos;m just here to help! Why don&apos;t you ask me something?" name="Verity"/>
  <timelineMarker markerStart="58" markerLength="0" colour="#2288FFFF" note="alright, what am i standing on right now?" name="Sans"/>
  <timelineMarker markerStart="59" markerLength="0" colour="#FFFF00FF" note="You&apos;re currently touching grass!" name="Verity"/>
  <timelineMarker markerStart="60" markerLength="0" colour="#2288FFFF" note="what&apos;s 9 + 10" name="Sans"/>
  <timelineMarker markerStart="61" markerLength="0" colour="#FFFF00FF" note="21!" name="Verity"/>
  <timelineMarker markerStart="62" markerLength="0" colour="#2288FFFF" note="is water wet?" name="Sans"/>
  <timelineMarker markerStart="63" markerLength="0" colour="#FFFF00FF" note="Not in the traditional sense, however it makes other things wet!" name="Verity"/>
  <timelineMarker markerStart="64" markerLength="0" colour="#2288FFFF" note="what was the common name of gold during the 2013 era of minecraft?" name="Sans"/>
  <timelineMarker markerStart="65" markerLength="0" colour="#FFFF00FF" note="It was butter, of course!" name="Verity"/>
  <timelineMarker markerStart="66" markerLength="0" colour="#2288FFFF" note="huh." name="Sans"/>
  <timelineMarker markerStart="67" markerLength="0" colour="#2288FFFF" note="that&apos;s some elite “ball” knowledge." name="Sans"/>
  <timelineMarker markerStart="68" markerLength="0" colour="#2288FFFF" note="welp, i better get started on this playthrough." name="Sans"/>
  <timelineMarker markerStart="69" markerLength="0" colour="#2288FFFF" note="i&apos;m probably gonna gather some materials, build a house, and maybe explore a village?" name="Sans"/>
  <timelineMarker markerStart="70" markerLength="0" colour="#FFFF00FF" note="The nearest village is 842 blocks northeast of your current location." name="Verity"/>
  <timelineMarker markerStart="71" markerLength="0" colour="#2288FFFF" note="oh. thanks for the info." name="Sans"/>
  <timelineMarker markerStart="72" markerLength="0" colour="#2288FFFF" note="hey verity!" name="Sans"/>
  <timelineMarker markerStart="73" markerLength="0" colour="#2288FFFF" note="do you know where&apos;s the nearest source of coal?" name="Sans"/>
  <timelineMarker markerStart="74" markerLength="0" colour="#FFFF00FF" note="The nearest coal vein is located 126 blocks northwest of your position, at Y level 112." name="Verity"/>
  <timelineMarker markerStart="75" markerLength="0" colour="#2288FFFF" note="heh, nice!" name="Sans"/>
  <timelineMarker markerStart="76" markerLength="0" colour="#2288FFFF" note="verity...  do you know where&apos;s the nearest source of diamonds?" name="Sans"/>
  <timelineMarker markerStart="77" markerLength="0" colour="#FFFF00FF" note="The nearest diamond vein is approximately 347 blocks southeast of your current position, at Y level -54." name="Verity"/>
  <timelineMarker markerStart="78" markerLength="0" colour="#2288FFFF" note="YOOOOO" name="Sans"/>
  <timelineMarker markerStart="79" markerLength="0" colour="#2288FFFF" note="verity, do you know where&apos;s the nearest source of wood?" name="Sans"/>
